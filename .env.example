DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinscope
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinscope
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinscope

# Safety guards: development/test refuse non-local DB hosts by default.
# Set either to true only when you intentionally want to use a remote DB.
ALLOW_EXTERNAL_DATABASE_IN_DEV=false
ALLOW_EXTERNAL_DATABASE_IN_TEST=false

PORT=5000

# Secret used to sign auth JWTs - set a long random value in production.
# In production this must be set explicitly.
JWT_SECRET=
JWT_ISSUER=vinscope-kenya-api
JWT_AUDIENCE=vinscope-kenya-app
ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_SESSION_IDLE_MINUTES=10080
# Production enforces secure httpOnly cookies and only allows sameSite=strict or lax.
AUTH_COOKIE_SAME_SITE=strict
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_FAILURES=5
LOGIN_IP_WINDOW_MINUTES=15
LOGIN_IP_LOCKOUT_MINUTES=15
OTP_SEND_MAX_PER_PHONE=5
OTP_SEND_MAX_PER_IP=20
OTP_SEND_WINDOW_MINUTES=15
OTP_SEND_LOCKOUT_MINUTES=30
OTP_VERIFY_MAX_FAILURES_PER_PHONE=5
OTP_VERIFY_MAX_FAILURES_PER_IP=10
OTP_VERIFY_WINDOW_MINUTES=15
OTP_VERIFY_LOCKOUT_MINUTES=30
ADMIN_EMAILS=murithimark@gmail.com
AUTH_ALERT_WINDOW_MINUTES=60
LOCKOUT_ALERT_THRESHOLD=3
REFRESH_REUSE_ALERT_THRESHOLD=1
AUTH_ALERT_WEBHOOK_URL=
AUTH_ALERT_SLACK_WEBHOOK_URL=
AUTH_ALERT_EMAIL_FROM=
AUTH_ALERT_EMAIL_TO=
RESEND_API_KEY=

# Restrict CORS to this origin (only needed if the frontend is hosted separately
# from this API, e.g. the Vite dev server during local development).
ALLOWED_ORIGIN=http://localhost:5173

# Public HTTPS URL of this deployed server, used as the M-Pesa callback URL.
PUBLIC_BASE_URL=https://vinscopekenya.onrender.com

# Safaricom Daraja (M-Pesa) credentials - required for the Pro/Business "Subscribe"
# flow to work. Leave unset to disable payments (the API will return a clear
# "M-Pesa is not configured" error instead of failing unpredictably).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=g5vSb9x0IN2UIoluGAOlpunDsSIqI4H5UPyVOXNuAupOw7ON
MPESA_CONSUMER_SECRET=NLCfoZiBQk9mvo8dZzphgp1zXG8LFcw3Eqvsw8B1HC0nnocGuWa3X22t7Gn6XePV
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Africa's Talking SMS credentials - required for real SMS delivery of signup/login
# verification codes. Leave unset and the code is logged to the server console
# instead (and echoed back in non-production API responses) so the flow still works locally.
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# When true, the SMS verification code is echoed back in the API response instead
# of being texted, even in production. Only enable this temporarily while a real
# SMS provider is not yet configured - it disables the security benefit of SMS
# verification, since anyone can read the code without owning the phone.
OTP_DEMO_MODE=false

